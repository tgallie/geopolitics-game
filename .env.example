# Copy to .env.local and fill in private values there only.
MONGODB_URI=
MONGODB_DB=geopolitics_game
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional until an API key is configured; fallback summaries keep the game playable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_COMMENTARY_ENABLED=true
